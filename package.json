{
  "name": "bharosa",
  "version": "0.9.0",
  "private": false,
  "description": "Typed Bharosa resource SDK with server credentials or caller-owned transport.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs",
        "default": "./dist/browser.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/browser.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.cts",
      "default": "./dist/testing.cjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CONTRACT-SHA256",
    "docs/",
    "examples/",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "FIRST-PARTY-CONTRACT-SHA256",
    "MONTHLY-MARKET-CONTRACT-SHA256",
    "ANALYTICS-CONTRACT-SHA256",
    "MARKET-SEARCH-CONTRACT-SHA256",
    "BENCHMARK-CONTRACT-SHA256"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "npm run build && npm run typecheck && node scripts/test.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run test:pack",
    "test:pack": "node scripts/pack-smoke.mjs",
    "test:examples": "node scripts/check-examples.mjs",
    "generate": "node scripts/generate.mjs",
    "generate:first-party": "node scripts/generate-first-party.mjs",
    "check:first-party": "node scripts/generate-first-party.mjs --check",
    "typecheck": "node tooling/node_modules/typescript/bin/tsc --noEmit && node tooling/node_modules/typescript/bin/tsc -p tsconfig.test.json --noEmit && node tooling/node_modules/typescript/bin/tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext --typeRoots tooling/node_modules/@types test/api-compatibility.ts",
    "generate:monthly": "node scripts/generate-monthly.mjs",
    "check:monthly": "node scripts/generate-monthly.mjs --check",
    "generate:analytics": "node scripts/generate-analytics.mjs",
    "check:analytics": "node scripts/generate-analytics.mjs --check",
    "generate:market-search": "node scripts/generate-market-search.mjs",
    "check:market-search": "node scripts/generate-market-search.mjs --check",
    "generate:benchmarks": "node scripts/generate-benchmarks.mjs",
    "check:benchmarks": "node scripts/generate-benchmarks.mjs --check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bhafin/sdk.git"
  }
}
