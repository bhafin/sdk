{
  "openapi": "3.1.0",
  "info": {
    "title": "Bharosa public market scheme search",
    "version": "local-candidate"
  },
  "paths": {
    "/v1/market-data/schemes/search": {
      "get": {
        "operationId": "searchMarketSchemes",
        "summary": "Search mutual fund schemes",
        "description": "Any active API key. Public scheme identities and latest NAV references only; no private account access. Shared market request quota applies. Query must contain 2\u2013100 characters; limit 1\u201320 (default10). No history dates or cursor pagination.",
        "security": [
          {
            "ApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "2\u2013100 characters. Case-insensitive label and identifier search; percent and underscore are literal.",
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "1\u201320; default 10. Search is a bounded result set, not cursor pagination.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "headers": {
              "Request-Id": {
                "schema": {
                  "type": "string"
                }
              },
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FundsList"
                },
                "example": {
                  "object": "list",
                  "data": [
                    {
                      "instrument": {
                        "id": "ins_markets_scheme_101",
                        "object": "instrument",
                        "created": 1792281600,
                        "name": "Example Equity Fund \u2014 Direct Growth",
                        "identifiers": [],
                        "domicile_country": "IN",
                        "type": "mutual_fund",
                        "mutual_fund": {
                          "fund_name": "Example Equity Fund",
                          "share_class": "Direct Growth",
                          "class_currency": "INR",
                          "distribution_policy": "accumulating"
                        }
                      },
                      "market": "IN",
                      "currency": "INR",
                      "scheme_id": "101",
                      "plan_label": "Direct",
                      "option_label": "Growth",
                      "amfi_code": null,
                      "isin": null,
                      "identity_status": "resolved",
                      "latest_nav": {
                        "amount": "42.125",
                        "currency": "INR",
                        "date": "2026-10-16"
                      },
                      "data_mode": "live",
                      "source": "calcengine_market_db",
                      "freshness": {
                        "status": "recent",
                        "checked_at": "2026-10-18T08:00:00Z",
                        "as_of": "2026-10-18",
                        "time_zone": "Asia/Kolkata",
                        "age_days": 2,
                        "recent_within_days": 3
                      }
                    }
                  ],
                  "has_more": false,
                  "url": "/v1/market-data/schemes/search",
                  "market_data": {
                    "mode": "live",
                    "notice": "Reference NAV is separate from entered holdings."
                  }
                }
              }
            }
          },
          "400": {
            "description": "See reviewed-contract.md for stable status/code and recovery semantics.",
            "headers": {
              "Request-Id": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
