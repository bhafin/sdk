    "/v1/accounts/{account}/market-data/valuations": {
      "post": {
        "operationId": "monthly_valuation",
        "x-availability": "first_party_or_configured_monthly_market_data",
        "x-sdk-method": "mutualFundSchemes.valuation",
        "description": "Latest NAV by default; historical as_of must be a month start for all callers. Requires a first-party browser session or an external credential with explicit server-configured monthly market-data capability, plus active account authorization.",
        "parameters": [
          {
            "name": "account",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(me|acct_[a-f0-9]{32})$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "scheme_id"
                ],
                "properties": {
                  "scheme_id": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,18}$"
                  },
                  "units": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,19})(\\.[0-9]{1,18})?$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "as_of": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "position_date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "observed_value": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,19})(\\.[0-9]{1,18})?$"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "scheme_id",
                        "units",
                        "as_of",
                        "value",
                        "nav",
                        "freshness",
                        "ownership_status",
                        "position_date",
                        "valuation_basis"
                      ],
                      "properties": {
                        "status": {
                          "const": "available"
                        },
                        "scheme_id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]{0,18}$"
                        },
                        "units": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]{0,19})(\\.[0-9]{1,18})?$"
                        },
                        "as_of": {
                          "type": "string",
                          "format": "date",
                          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                          "description": "NAV cutoff date. Defaults to today in Asia/Kolkata; separate from investor position date and actual NAV date."
                        },
                        "value": {
                          "type": "object",
                          "required": [
                            "amount",
                            "currency"
                          ],
                          "properties": {
                            "amount": {
                              "type": "string",
                              "pattern": "^[0-9]+(\\.[0-9]+)?$"
                            },
                            "currency": {
                              "const": "INR"
                            }
                          },
                          "additionalProperties": true
                        },
                        "nav": {
                          "type": "object",
                          "required": [
                            "amount",
                            "currency",
                            "date"
                          ],
                          "properties": {
                            "amount": {
                              "type": "string",
                              "pattern": "^[0-9]+(\\.[0-9]+)?$"
                            },
                            "currency": {
                              "const": "INR"
                            },
                            "date": {
                              "type": "string",
                              "format": "date",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                              "description": "Actual NAV observation date, on or before as_of; never relabelled as the requested cutoff."
                            }
                          },
                          "additionalProperties": true
                        },
                        "freshness": {
                          "type": "object",
                          "required": [
                            "status",
                            "age_days",
                            "recent_within_days",
                            "time_zone"
                          ],
                          "properties": {
                            "status": {
                              "enum": [
                                "recent",
                                "stale"
                              ]
                            },
                            "age_days": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "recent_within_days": {
                              "const": 3,
                              "description": "Calendar-day freshness threshold, inclusive."
                            },
                            "time_zone": {
                              "const": "Asia/Kolkata",
                              "description": "Financial-date timezone used for the default cutoff."
                            }
                          },
                          "additionalProperties": true,
                          "description": "Age is measured against the requested NAV cutoff, not the position date. recent means age_days <= 3; stale means greater than 3."
                        },
                        "position_date": {
                          "anyOf": [
                            {
                              "type": "string",
                              "format": "date",
                              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Supplied investor-position observation date, or null when omitted. It does not establish current ownership and must not exceed as_of."
                        },
                        "ownership_status": {
                          "const": "user_supplied_not_verified",
                          "description": "Supplied quantities and dates are not independent verification of current ownership."
                        },
                        "valuation_basis": {
                          "const": "units_times_latest_nav",
                          "description": "Exact decimal units multiplied by latest positive INR NAV on or before as_of."
                        }
                      },
                      "additionalProperties": true
                    },
                    {
                      "type": "object",
                      "required": [
                        "status",
                        "reason",
                        "scheme_id",
                        "as_of",
                        "observed_value",
                        "position_date",
                        "ownership_status"
                      ],
                      "properties": {
                        "status": {
                          "const": "unavailable"
                        },
                        "reason": {
                          "const": "quantity_missing"
                        },
                        "scheme_id": {
