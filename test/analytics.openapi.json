                      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                    },
                    "source_version": {
                      "type": "string"
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "object": {
                      "const": "scheme_performance"
                    },
                    "scheme_id": {
                      "type": "string"
                    },
                    "fund_id": {
                      "type": "string"
                    },
                    "plan": {
